{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piba.local/schemas/secure-session-phase-receipt.json",
  "title": "Secure session rollout phase receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "phase", "environment", "startedAt", "completedAt", "actor", "actorRole", "manifestSha256", "inputSha256", "outputSha256", "status", "evidence"],
  "properties": {
    "releaseId": { "$ref": "#/$defs/nonPlaceholder" },
    "phase": { "enum": ["foundation-deploy", "function-deploy", "client-deploy", "backfill", "cutover", "cutover-execution", "rollback"] },
    "environment": { "enum": ["local", "staging", "production"] },
    "startedAt": { "$ref": "#/$defs/operationalDateTime" },
    "completedAt": { "$ref": "#/$defs/operationalDateTime" },
    "actor": { "$ref": "#/$defs/nonPlaceholder" },
    "actorRole": { "enum": ["database-operator", "function-operator", "client-operator", "backfill-operator", "release-owner", "incident-commander"] },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "inputSha256": { "$ref": "#/$defs/sha256" },
    "outputSha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["approved", "succeeded", "failed", "rolled-back"] },
    "evidence": { "type": "object", "minProperties": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "foundation-deploy" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actorRole": { "const": "database-operator" }, "status": { "const": "succeeded" },
          "evidence": {
            "type": "object", "additionalProperties": false, "required": ["migrationVersion", "migrationListSha256"],
            "properties": { "migrationVersion": { "const": "20260408020000" }, "migrationListSha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "function-deploy" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actorRole": { "const": "function-operator" }, "status": { "const": "succeeded" },
          "evidence": {
            "type": "object", "additionalProperties": false, "required": ["functionVersion", "deployedFunctions", "sourceBundles"],
            "properties": {
              "functionVersion": { "$ref": "#/$defs/nonPlaceholder" },
              "deployedFunctions": { "$ref": "#/$defs/functionNames" },
              "sourceBundles": { "$ref": "#/$defs/functionBundles" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "client-deploy" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actorRole": { "const": "client-operator" }, "status": { "const": "succeeded" },
          "evidence": {
            "type": "object", "additionalProperties": false, "required": ["clientVersion", "providerDeploymentId", "immutableUrl", "assetManifestSha256", "proxyEnvironmentNames", "proxyEnvironmentVerified"],
            "properties": {
              "clientVersion": { "$ref": "#/$defs/nonPlaceholder" }, "providerDeploymentId": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]{8,}$" },
              "immutableUrl": { "$ref": "#/$defs/vercelUrl" }, "assetManifestSha256": { "$ref": "#/$defs/sha256" },
              "proxyEnvironmentNames": { "const": ["PIBA_PROXY_SECRET", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_URL"] },
              "proxyEnvironmentVerified": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "backfill" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actorRole": { "const": "backfill-operator" }, "status": { "const": "succeeded" },
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["expectedProjectRef", "expectedSupabaseUrl", "configuredSecretNames", "serverEnvironmentVerified", "authorizationRotated", "expected", "processed", "skipped", "verified", "remaining"],
            "properties": {
              "expectedProjectRef": { "$ref": "#/$defs/nonPlaceholder" }, "expectedSupabaseUrl": { "type": "string", "format": "uri", "pattern": "^https://.+\\.supabase\\.co$" },
              "configuredSecretNames": { "const": ["PIBA_DEPLOY_ENV", "PIBA_BACKFILL_PROJECT_REF", "PIBA_BACKFILL_RELEASE_ID", "PIBA_BACKFILL_SECRET", "PIBA_BACKFILL_EXPECTED_COUNT"] },
              "serverEnvironmentVerified": { "const": true }, "authorizationRotated": { "const": true },
              "expected": { "type": "integer", "minimum": 1 }, "processed": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 }, "verified": { "type": "integer", "minimum": 1 }, "remaining": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "cutover" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actorRole": { "const": "release-owner" },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verifiedCredentials", "expectedCredentials", "targetMigrationState", "functionVersionEvidence", "clientVersionEvidence", "observationOwner", "observationOperator", "observationStartedAt", "observationEndedAt", "observationQueryIds", "observationOutputSha256", "observationDurationMinutes", "productionDetectionEvidenceSha256", "sloResults", "automaticRollbackTriggered", "manualRollbackDecision", "incidentReceiptId", "incidentReceiptPath", "incidentReceiptSha256", "decision", "approvals"],
            "properties": {
              "verifiedCredentials": { "type": "integer", "minimum": 1 },
              "expectedCredentials": { "type": "integer", "minimum": 1 },
              "targetMigrationState": { "const": "hash_only" },
              "functionVersionEvidence": {
                "type": "object", "additionalProperties": false,
                "required": ["version", "receiptPath", "receiptSha256", "deploymentOutputSha256"],
                "properties": {
                  "version": { "$ref": "#/$defs/nonPlaceholder" },
                  "receiptPath": { "const": "ops/secure-sessions/evidence/function-deploy.receipt.json" },
                  "receiptSha256": { "$ref": "#/$defs/sha256" },
                  "deploymentOutputSha256": { "$ref": "#/$defs/sha256" }
                }
              },
              "clientVersionEvidence": {
                "type": "object", "additionalProperties": false,
                "required": ["version", "receiptPath", "receiptSha256", "providerDeploymentId", "assetManifestSha256"],
                "properties": {
                  "version": { "$ref": "#/$defs/nonPlaceholder" },
                  "receiptPath": { "const": "ops/secure-sessions/evidence/client-deploy.receipt.json" },
                  "receiptSha256": { "$ref": "#/$defs/sha256" },
                  "providerDeploymentId": { "$ref": "#/$defs/nonPlaceholder" },
                  "assetManifestSha256": { "$ref": "#/$defs/sha256" }
                }
              },
              "observationOwner": { "$ref": "#/$defs/nonPlaceholder" },
              "observationOperator": { "$ref": "#/$defs/nonPlaceholder" },
              "observationStartedAt": { "$ref": "#/$defs/operationalDateTime" },
              "observationEndedAt": { "$ref": "#/$defs/operationalDateTime" },
              "observationQueryIds": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/nonPlaceholder" } },
              "observationOutputSha256": { "$ref": "#/$defs/sha256" },
              "observationDurationMinutes": { "type": "number", "minimum": 30 },
              "productionDetectionEvidenceSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
              "sloResults": { "$ref": "#/$defs/sloResults" },
              "automaticRollbackTriggered": { "type": "boolean" },
              "manualRollbackDecision": { "enum": ["not-required", "rollback-required"] },
              "incidentReceiptId": { "anyOf": [{ "$ref": "#/$defs/nonPlaceholder" }, { "type": "null" }] },
              "incidentReceiptPath": { "anyOf": [{ "$ref": "#/$defs/incidentReceiptPath" }, { "type": "null" }] },
              "incidentReceiptSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
              "decision": { "enum": ["proceed", "rollback"] },
              "approvals": { "$ref": "#/$defs/cutoverApprovals" }
            },
            "allOf": [
              {
                "if": { "properties": { "automaticRollbackTriggered": { "const": true } }, "required": ["automaticRollbackTriggered"] },
                "then": { "properties": { "manualRollbackDecision": { "const": "not-required" }, "incidentReceiptId": { "$ref": "#/$defs/nonPlaceholder" }, "incidentReceiptPath": { "$ref": "#/$defs/incidentReceiptPath" }, "incidentReceiptSha256": { "$ref": "#/$defs/sha256" }, "decision": { "const": "rollback" } } }
              },
              {
                "if": { "properties": { "automaticRollbackTriggered": { "const": false }, "manualRollbackDecision": { "const": "rollback-required" } }, "required": ["automaticRollbackTriggered", "manualRollbackDecision"] },
                "then": {
                  "properties": { "incidentReceiptId": { "$ref": "#/$defs/nonPlaceholder" }, "incidentReceiptPath": { "$ref": "#/$defs/incidentReceiptPath" }, "incidentReceiptSha256": { "$ref": "#/$defs/sha256" }, "decision": { "const": "rollback" } },
                  "properties": { "sloResults": { "contains": { "properties": { "decision": { "const": "fail" } }, "required": ["decision"] }, "minContains": 1 } }
                }
              },
              {
                "if": { "properties": { "automaticRollbackTriggered": { "const": false }, "manualRollbackDecision": { "const": "not-required" } }, "required": ["automaticRollbackTriggered", "manualRollbackDecision"] },
                "then": { "properties": { "incidentReceiptId": { "type": "null" }, "incidentReceiptPath": { "type": "null" }, "incidentReceiptSha256": { "type": "null" }, "decision": { "const": "proceed" }, "sloResults": { "$ref": "#/$defs/passingSloResults" } } }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "environment": { "const": "production" } }, "required": ["environment"] },
            "then": { "properties": { "evidence": { "properties": { "productionDetectionEvidenceSha256": { "$ref": "#/$defs/sha256" } } } } }
          },
          {
            "if": { "properties": { "evidence": { "properties": { "decision": { "const": "proceed" } }, "required": ["decision"] } }, "required": ["evidence"] },
            "then": { "properties": { "status": { "const": "approved" } } }
          },
          {
            "if": { "properties": { "evidence": { "properties": { "decision": { "const": "rollback" } }, "required": ["decision"] } }, "required": ["evidence"] },
            "then": { "properties": { "status": { "enum": ["failed", "rolled-back"] } } }
          }
        ]
      }
    },
    {
      "if": { "properties": { "phase": { "const": "cutover-execution" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actorRole": { "const": "release-owner" }, "status": { "const": "succeeded" },
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["gitCommit", "authorizationReceiptPath", "authorizationReceiptSha256", "sqlPath", "sqlSha256", "sqlOutputSha256", "resultingMigrationState"],
            "properties": {
              "gitCommit": { "type": "string", "pattern": "^(?!([0-9a-f])\\1{39}$)[0-9a-f]{40}$" },
              "authorizationReceiptPath": { "const": "ops/secure-sessions/evidence/cutover.receipt.json" },
              "authorizationReceiptSha256": { "$ref": "#/$defs/sha256" },
              "sqlPath": { "const": "ops/secure-sessions/cutover.sql" }, "sqlSha256": { "$ref": "#/$defs/sha256" },
              "sqlOutputSha256": { "$ref": "#/$defs/sha256" }, "resultingMigrationState": { "const": "hash_only" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "rollback" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actorRole": { "const": "incident-commander" }, "status": { "const": "rolled-back" },
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["priorFunctionGitSha", "restoredFunctionBundles", "overwrittenFunctions", "priorVercelDeploymentId", "priorVercelImmutableUrl", "vercelRollbackCommand", "sqlRollbackPath", "sqlRollbackSha256", "cutoverExecutionReceiptPath", "cutoverExecutionReceiptSha256", "authorizationReceiptSha256", "expectedReleaseId", "checkpointReceiptPath", "checkpointReceiptSha256", "familiesRevoked", "compatibilityEndsAt"],
            "properties": {
              "priorFunctionGitSha": { "type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$" },
              "restoredFunctionBundles": { "$ref": "#/$defs/functionBundles" },
              "overwrittenFunctions": { "$ref": "#/$defs/functionNames" },
              "priorVercelDeploymentId": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]{8,}$" },
              "priorVercelImmutableUrl": { "type": "string", "pattern": "^https://[A-Za-z0-9-]+-[A-Za-z0-9-]+\\.vercel\\.app$" },
              "vercelRollbackCommand": { "type": "string", "pattern": "^npx vercel rollback (?:dpl_[A-Za-z0-9]{8,}|https://[A-Za-z0-9-]+-[A-Za-z0-9-]+\\.vercel\\.app)$" },
              "sqlRollbackPath": { "const": "ops/secure-sessions/rollback.sql" },
              "sqlRollbackSha256": { "$ref": "#/$defs/sha256" },
              "cutoverExecutionReceiptPath": { "const": "ops/secure-sessions/evidence/cutover-execution.receipt.json" },
              "cutoverExecutionReceiptSha256": { "$ref": "#/$defs/sha256" },
              "authorizationReceiptSha256": { "$ref": "#/$defs/sha256" },
              "expectedReleaseId": { "$ref": "#/$defs/nonPlaceholder" },
              "checkpointReceiptPath": { "type": "string", "pattern": "^ops/secure-sessions/evidence/rollback-checkpoint-[A-Za-z0-9._-]+\\.json$" },
              "checkpointReceiptSha256": { "$ref": "#/$defs/sha256" },
              "familiesRevoked": { "const": true },
              "compatibilityEndsAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^(?!([0-9a-f])\\1{63}$)[0-9a-f]{64}$" },
    "nonPlaceholder": { "type": "string", "minLength": 3, "pattern": "^(?!(?:REPLACE(?:_|$)|TBD(?:_|$)|TODO(?:_|$)|CHANGEME(?:_|$)|YOUR[_-]|EXAMPLE(?:_|$)|<[^>]+>$)).+" },
    "operationalDateTime": { "type": "string", "format": "date-time", "pattern": "^(?!1970-01-01T)" },
    "vercelUrl": { "type": "string", "pattern": "^https://[A-Za-z0-9-]+-[A-Za-z0-9-]+\\.vercel\\.app$" },
    "functionNames": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "session-login" } }, { "contains": { "const": "session-refresh" } }, { "contains": { "const": "session-logout" } },
        { "contains": { "const": "session-users" } }, { "contains": { "const": "session-profile" } }, { "contains": { "const": "backfill" } }
      ],
      "items": { "enum": ["session-login", "session-refresh", "session-logout", "session-users", "session-profile", "backfill"] }
    },
    "functionBundles": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "location", "sourceSha256"],
        "properties": { "name": { "enum": ["session-login", "session-refresh", "session-logout", "session-users", "session-profile", "backfill"] }, "location": { "type": "string", "pattern": "^ops/secure-sessions/artifacts/functions/[A-Za-z0-9._/-]+\\.tar\\.gz$" }, "sourceSha256": { "$ref": "#/$defs/sha256" } }
      }
    },
    "rollbackCheckpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseId", "expectedReleaseId", "environment", "gitCommit", "manifestSha256", "executionReceiptSha256", "authorizationReceiptSha256", "allowedSteps", "completedSteps", "updatedAt"],
      "properties": {
        "releaseId": { "$ref": "#/$defs/nonPlaceholder" }, "expectedReleaseId": { "$ref": "#/$defs/nonPlaceholder" },
        "environment": { "enum": ["staging", "production"] }, "gitCommit": { "type": "string", "pattern": "^(?!([0-9a-f])\\1{39}$)[0-9a-f]{40}$" },
        "manifestSha256": { "$ref": "#/$defs/sha256" }, "executionReceiptSha256": { "$ref": "#/$defs/sha256" }, "authorizationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "allowedSteps": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
        "completedSteps": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
        "updatedAt": { "$ref": "#/$defs/operationalDateTime" }
      }
    },
    "incidentReceiptPath": { "type": "string", "pattern": "^ops/secure-sessions/evidence/incident-[A-Za-z0-9][A-Za-z0-9._-]{2,127}\\.receipt\\.json$" },
    "sloResults": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["endpoint", "queryId", "owner", "sampleCount", "unexpectedErrorRate", "nonSuccessRate", "authThrottleRate", "p95Ms", "thresholdUnexpectedErrorRateMaxExclusive", "thresholdNonSuccessRateMaxExclusive", "thresholdAuthThrottleRateMaxExclusive", "thresholdP95MsMaxExclusive", "decision"],
        "properties": {
          "endpoint": { "enum": ["login", "refresh", "logout", "current-user", "list-users", "create-user", "update-profile"] },
          "queryId": { "$ref": "#/$defs/nonPlaceholder" }, "owner": { "$ref": "#/$defs/nonPlaceholder" }, "sampleCount": { "type": "integer", "minimum": 30 },
          "unexpectedErrorRate": { "type": "number", "minimum": 0, "maximum": 1 }, "nonSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 }, "authThrottleRate": { "type": "number", "minimum": 0, "maximum": 1 }, "p95Ms": { "type": "number", "minimum": 0 },
          "thresholdUnexpectedErrorRateMaxExclusive": { "const": 0.01 }, "thresholdNonSuccessRateMaxExclusive": { "const": 0.02 }, "thresholdAuthThrottleRateMaxExclusive": { "const": 0.05 }, "thresholdP95MsMaxExclusive": { "const": 750 }, "decision": { "enum": ["pass", "fail"] }
        },
        "allOf": [{
          "if": { "properties": { "decision": { "const": "pass" } }, "required": ["decision"] },
          "then": { "properties": { "unexpectedErrorRate": { "exclusiveMaximum": 0.01 }, "nonSuccessRate": { "exclusiveMaximum": 0.02 }, "authThrottleRate": { "exclusiveMaximum": 0.05 }, "p95Ms": { "exclusiveMaximum": 750 } } },
          "else": { "anyOf": [{ "properties": { "unexpectedErrorRate": { "minimum": 0.01 } } }, { "properties": { "nonSuccessRate": { "minimum": 0.02 } } }, { "properties": { "authThrottleRate": { "minimum": 0.05 } } }, { "properties": { "p95Ms": { "minimum": 750 } } }] }
        }]
      },
      "allOf": [
        { "contains": { "properties": { "endpoint": { "const": "login" } }, "required": ["endpoint"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "endpoint": { "const": "refresh" } }, "required": ["endpoint"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "endpoint": { "const": "logout" } }, "required": ["endpoint"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "endpoint": { "const": "current-user" } }, "required": ["endpoint"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "endpoint": { "const": "list-users" } }, "required": ["endpoint"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "endpoint": { "const": "create-user" } }, "required": ["endpoint"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "endpoint": { "const": "update-profile" } }, "required": ["endpoint"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "passingSloResults": {
      "allOf": [
        { "$ref": "#/$defs/sloResults" },
        { "items": { "properties": { "decision": { "const": "pass" } } } }
      ]
    },
    "cutoverApprovals": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "actor", "approvedAt"],
        "properties": {
          "role": { "enum": ["release-owner", "function-operator"] }, "actor": { "$ref": "#/$defs/nonPlaceholder" },
          "approvedAt": { "$ref": "#/$defs/operationalDateTime" }
        }
      },
      "allOf": [
        { "contains": { "properties": { "role": { "const": "release-owner" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "role": { "const": "function-operator" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 }
      ]
    }
  }
}
