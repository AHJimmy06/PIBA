{
  "name": "piba_alabanza",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "verify:secure-sessions": "node scripts/verify-secure-session-foundation.mjs --offline-fixture && bash -n scripts/run-secure-session-sql-harness.sh",
    "validate:secure-session-cutover": "node scripts/verify-secure-session-foundation.mjs --validate-cutover",
    "detect:secure-session-production": "node scripts/verify-secure-session-foundation.mjs --run-production-detection",
    "rollback:secure-sessions": "bash -c 'set -euo pipefail; node scripts/verify-secure-session-foundation.mjs --execute-rollback \"$@\"' --",
    "test:deno": "deno test --config supabase/functions/deno.json --lock supabase/functions/deno.lock --allow-env supabase/functions",
    "check:deno": "deno check --config supabase/functions/deno.json --lock supabase/functions/deno.lock supabase/functions/session-login/index.ts supabase/functions/session-refresh/index.ts supabase/functions/session-logout/index.ts supabase/functions/session-users/index.ts supabase/functions/session-profile/index.ts supabase/functions/backfill/index.ts supabase/functions/endpoint-matrix.test.ts supabase/functions/refresh-db.integration.test.ts",
    "test:sql": "bash scripts/run-secure-session-sql-harness.sh",
    "test:client-security": "vitest --run src/test/session-api.test.ts src/test/auth-context.test.tsx src/test/login-view.test.tsx",
    "security:gate": "npm run verify:secure-sessions && npm run check:deno && npm run test:deno && npm run test:sql && npm run test:client-security && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/supabase-js": "^2.98.0",
    "@types/react-router-dom": "^5.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "hash-wasm": "4.12.0",
    "jose": "6.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
